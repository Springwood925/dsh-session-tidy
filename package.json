{
  "name": "@local/dsh-session-tidy",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "无感会话整理：定时把 N 天没动过的会话自动归档（只归档不删除）。阈值与规则可在插件详情页直接调整。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
