{
  "name": "@local/dsh-session-tidy",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: silently archives stale sessions, dedupes rotated copies, backs up before archiving, and prunes idle workspace registrations. Configure from the plugin detail page.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "archive",
    "cleanup"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Springwood925/dsh-session-tidy.git"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
